PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=*

# Database Connection (Local Docker Compose)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=catalog_db

# Railway Injected Variables (Uncomment in Railway Dashboard or use Reference Variables)
# MYSQLHOST=mysql.railway.internal
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=generated_password
# MYSQLDATABASE=railway
# MYSQL_URL=mysql://root:generated_password@mysql.railway.internal:3306/railway

# Cloudinary Integration (Approach 2 - Server Side Upload)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

